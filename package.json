{
  "name": "promosg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "db:seed": "psql \"$SUPABASE_DB_URL\" -f supabase/seed.sql",
    "pages:build": "opennextjs-cloudflare build && node scripts/adapt-for-pages.mjs",
    "pages:deploy": "opennextjs-cloudflare build && node scripts/adapt-for-pages.mjs && wrangler pages deploy pages-dist --project-name promosg"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
