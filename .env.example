# Supabase — get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (for running seed.sql via psql) — optional
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres

# Secret that protects the daily expiry cron route (/api/cron/expire)
CRON_SECRET=generate-a-long-random-string

# Public site URL (used in metadata / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
