{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "promosg-cron",
  "main": "index.js",
  "compatibility_date": "2025-03-01",
  // Daily: archive expired promos (free, no AI).
  // Weekly (Mon 02:30 SGT): pull fresh deals (minimal AI usage).
  "triggers": {
    "crons": ["0 18 * * *", "30 18 * * SUN"]
  },
  "observability": {
    "enabled": true
  }
}
